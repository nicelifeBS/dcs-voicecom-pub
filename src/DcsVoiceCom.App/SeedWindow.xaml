<Window x:Class="DcsVoiceCom.App.SeedWindow" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DcsVoiceCom.App"
        Title="{Binding Aircraft, StringFormat='Seed {0} from DCS-BIOS'}" Width="1000" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
  <Window.Resources>
    <local:BoolToVisibility x:Key="Visible" />
    <local:NotEmptyToVisibility x:Key="NotEmpty" />
  </Window.Resources>
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" />
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,14"
               Text="Tick the panels you want. Every command is added disabled: check its voice line and steps, test it in the cockpit, then tick it in the command list. Commands you edit or enable are yours; seeding again or removing seeded commands leaves them alone." />

    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button DockPanel.Dock="Right" Content="{Binding AddText}" IsEnabled="{Binding CanAdd}" IsDefault="True" Style="{StaticResource Primary}"
              MinWidth="140" Click="Add_Click" />
      <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="80" Margin="0,0,8,0" />
      <Button DockPanel.Dock="Left" Content="All panels" Style="{StaticResource Small}" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" />
      <Button DockPanel.Dock="Left" Content="None" Style="{StaticResource Small}" Command="{Binding SelectNoneCommand}" />
      <Border />
    </DockPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="PANELS" Style="{StaticResource Heading}" />
        <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                <Border DockPanel.Dock="Right" Background="{StaticResource AccentDark}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center"
                        Visibility="{Binding HasCritical, Converter={StaticResource Visible}}" ToolTip="Has critical commands (jettison, ejection, fire…)">
                  <TextBlock Text="!" FontSize="11" Foreground="{StaticResource Accent}" />
                </Border>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <DockPanel Grid.Column="2">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Voice line, panel or DCS-BIOS control ID" />
          <TextBlock Text="Search all panels…" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                     Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource Visible}}" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewTitle}" Style="{StaticResource Heading}" />
        <ListBox ItemsSource="{Binding Preview}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel x:Name="Row">
                <Border DockPanel.Dock="Right" Background="{StaticResource AccentDark}" CornerRadius="4" Padding="5,1" VerticalAlignment="Top"
                        Visibility="{Binding Critical, Converter={StaticResource Visible}}">
                  <TextBlock Text="critical" FontSize="11" Foreground="{StaticResource Accent}" />
                </Border>
                <StackPanel>
                  <TextBlock Text="{Binding VoiceLine, StringFormat='“{0}”'}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Steps, Mode=OneWay}" />
                    <Run Text="{Binding StatusText, Mode=OneWay}" Foreground="{StaticResource Info}" />
                  </TextBlock>
                </StackPanel>
              </DockPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCovered}" Value="True">
                  <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
