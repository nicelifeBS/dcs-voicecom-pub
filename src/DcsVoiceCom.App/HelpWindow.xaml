<Window x:Class="DcsVoiceCom.App.HelpWindow" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DcsVoiceCom.App"
        Title="Help" Width="1040" Height="760" MinWidth="720" MinHeight="480" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
  <Window.Resources>
    <local:BoolToVisibility x:Key="Visible" />
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="Close_Executed" />
  </Window.CommandBindings>

  <DockPanel Margin="20">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource Primary}" MinWidth="90"
              Command="{x:Static ApplicationCommands.Close}" />
      <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
    </DockPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Topics -->
      <DockPanel Grid.Column="0">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Searches the text of every topic" />
          <TextBlock Text="Search help…" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                     Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource Visible}}" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="No topic matches." Style="{StaticResource MutedText}" Margin="2,4,0,0"
                   Visibility="{Binding HasNoMatch, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
        <ListBox x:Name="TopicList" ItemsSource="{Binding Items}" SelectionChanged="TopicList_SelectionChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="Padding" Value="10,6" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                  <Setter Property="Focusable" Value="False" />
                  <Setter Property="IsHitTestVisible" Value="False" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <TextBlock Text="{Binding Text}" Style="{StaticResource Heading}" Margin="2,10,0,2" />
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Page -->
      <FlowDocumentScrollViewer x:Name="Page" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                IsToolBarVisible="False" Focusable="False" />
    </Grid>
  </DockPanel>
</Window>
