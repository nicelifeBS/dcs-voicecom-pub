<Window x:Class="DcsVoiceCom.App.PromptWindow" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
  <StackPanel Margin="20">
    <TextBlock x:Name="LabelText" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
    <ComboBox x:Name="Input" IsEditable="True" IsTextSearchEnabled="True" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="80" />
      <Button Content="OK" IsDefault="True" Style="{StaticResource Primary}" MinWidth="80" Click="Ok_Click" />
    </StackPanel>
  </StackPanel>
</Window>
