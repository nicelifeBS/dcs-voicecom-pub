<Window x:Class="DcsVoiceCom.App.EnterValueWindow" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DcsVoiceCom.App"
        Title="Enter value" Width="1060" Height="840" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
  <Window.Resources>
    <local:BoolToVisibility x:Key="Visible" />
    <local:NotEmptyToVisibility x:Key="NotEmpty" />
    <SolidColorBrush x:Key="KeypadBar" Color="#7fb2e5" />

    <!-- One character of the display: a flat button that shows its field and selection. -->
    <Style x:Key="Cell" TargetType="Button">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="80" />
      <Setter Property="FontSize" Value="40" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Background" Value="#0b0e10" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Muted}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding DataContext.CompactCells, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter Property="Width" Value="32" />
          <Setter Property="Height" Value="50" />
          <Setter Property="FontSize" Value="24" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Wheel">
          <Setter Property="Background" Value="#13181c" />
          <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Keypad">
          <Setter Property="Background" Value="#13181c" />
          <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="ReadOnly">
          <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentDark}" />
          <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
          <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- The bar under a cell: which field it belongs to. -->
    <Style x:Key="Bar" TargetType="Border">
      <Setter Property="Height" Value="18" />
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Wheel">
          <Setter Property="Background" Value="{StaticResource Muted}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Keypad">
          <Setter Property="Background" Value="{StaticResource KeypadBar}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="ReadOnly">
          <Setter Property="Background" Value="{StaticResource LineStrong}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding InSelectedField}" Value="True">
          <Setter Property="Background" Value="{StaticResource Accent}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A kind button that shows when it is the selected field's kind. -->
    <Style x:Key="KindOn" TargetType="Button" BasedOn="{StaticResource Small}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentDark}" />
          <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel Margin="20">
    <!-- Save / Cancel -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button DockPanel.Dock="Right" Content="Save" IsDefault="True" Style="{StaticResource Primary}" MinWidth="90" Click="Ok_Click" />
      <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="80" Margin="0,0,8,0" />
      <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                 Text="The display is read live while DCS flies this profile's aircraft. Setting up fields needs DCS running." />
    </DockPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- Spoken value, display, method -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Margin="0,0,16,0">
              <TextBlock Text="SPOKEN VALUE" Style="{StaticResource Heading}" />
              <ComboBox ItemsSource="{Binding Slots}" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" IsEditable="True" Width="160"
                        ToolTip="A slot of the voice line, e.g. {freq} or {text}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Margin="0,0,16,0">
              <TextBlock Text="READ BACK (DISPLAY)" Style="{StaticResource Heading}" />
              <local:SearchBox Items="{Binding StringOutputs}" Text="{Binding Display, UpdateSourceTrigger=LostFocus}" Width="240"
                               ToolTip="The display that shows the value. Every wheel is read from it, and it is checked after entering. Type words to search." />
            </StackPanel>
            <StackPanel DockPanel.Dock="Left">
              <TextBlock Text="CHECK TIMEOUT" Style="{StaticResource Heading}" />
              <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Width="70" />
                <TextBlock Text="ms" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="6,0,0,0" />
              </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right">
              <TextBlock Text="HOW IT IS ENTERED" Style="{StaticResource Heading}" />
              <StackPanel Orientation="Horizontal">
                <ToggleButton Content="Switches / dials" IsChecked="{Binding IsWheels}" Margin="0,0,6,0"
                              ToolTip="Wheels and switches turned until the display shows each part (radios, TACAN)" />
                <ToggleButton Content="Keypad" IsChecked="{Binding IsKeypad}"
                              ToolTip="One key per character into one field (CDU)" />
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Display fields -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="Learn from display…" Command="{Binding LearnCommand}" Style="{StaticResource Small}" Margin="8,0,0,0"
                      ToolTip="With DCS running: operates the knobs or keys once, watches the display and builds the fields. Puts them back afterwards." />
              <Button DockPanel.Dock="Right" Content="{Binding SuggestLabel}" Command="{Binding SuggestCommand}" Style="{StaticResource Small}"
                      ToolTip="Finds the radio's controls and, with DCS running, places them on the display" />
              <TextBlock Text="DISPLAY FIELDS" Style="{StaticResource Heading}" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBlock Text="{Binding LiveStatus}" Foreground="{StaticResource Good}" FontSize="12" VerticalAlignment="Center"
                         Visibility="{Binding IsLive, Converter={StaticResource Visible}}" />
              <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,12,0"
                         Text="Click a character. Shift+click to widen. Then make it a field." />
            </DockPanel>

            <Border Background="#2b1a12" BorderBrush="#7a3e26" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                    Visibility="{Binding IsLive, Converter={StaticResource Visible}, ConverterParameter=invert}">
              <TextBlock Text="{Binding LiveStatus}" Foreground="#ffb59a" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Visibility="{Binding ShowLearnPanel, Converter={StaticResource Visible}}">
              <StackPanel>
                <TextBlock Text="LEARN FROM DISPLAY" Style="{StaticResource Heading}" Margin="0,0,0,6" />
                <StackPanel Visibility="{Binding CanEditLearnList, Converter={StaticResource Visible}}">
                  <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"
                             Text="Tick the controls to try. Each one is operated once, then put back. Power, arm, fire, ENT and similar are never touched." />
                  <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LearnCandidates}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{Binding IsTicked}" Margin="0,2">
                            <TextBlock>
                              <Run Text="{Binding Control, Mode=OneWay}" FontWeight="SemiBold" />
                              <Run Text="{Binding Kind, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                              <Run Text="{Binding Description, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                            </TextBlock>
                          </CheckBox>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="Start" Command="{Binding StartLearnCommand}" Style="{StaticResource Small}"
                          Visibility="{Binding CanEditLearnList, Converter={StaticResource Visible}}" />
                  <Button Content="Add category…" Command="{Binding AddLearnCategoryCommand}" Style="{StaticResource Small}" Margin="8,0,0,0"
                          Visibility="{Binding CanEditLearnList, Converter={StaticResource Visible}}" />
                  <Button Content="Cancel" Command="{Binding CancelLearnCommand}" Style="{StaticResource Small}" Margin="8,0,0,0" />
                  <TextBlock Text="{Binding LearnProgress}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding LegacyNote}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding HasLegacyNote, Converter={StaticResource Visible}}" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" Visibility="{Binding HasHiddenKeys, Converter={StaticResource Visible}}"
                       Text="This step also presses keys before or after the text (from an older version). They still work; add new ones as steps in the main window." />

            <!-- The cells -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Center">
              <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="2,0">
                      <Button Style="{StaticResource Cell}" Content="{Binding Text}" Tag="{Binding Index}" Click="Cell_Click"
                              ToolTip="Click to pick, Shift+click to widen" />
                      <Border Style="{StaticResource Bar}" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="#101316" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="ReadOnly">
                                  <Setter Property="Foreground" Value="{StaticResource Text}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding InSelectedField}" Value="True">
                                  <Setter Property="Foreground" Value="#101316" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                      <TextBlock Text="{Binding Target}" HorizontalAlignment="Center" Margin="0,3,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="15">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Changes}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Good}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="No display picked yet. Pick the read-back display above, or use Fill from radio…" Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                       Visibility="{Binding Cells.Count, Converter={StaticResource NotEmpty}, ConverterParameter=invert}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
              <TextBlock Text="Try a spoken value" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Text="{Binding Try, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Width="200" />
              <TextBlock Text="green = characters that will change" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <!-- The selected field -->
            <Border Background="{StaticResource Field}" BorderBrush="{StaticResource LineStrong}" BorderThickness="2" CornerRadius="6" Padding="12" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Pick one or more characters on the display." Style="{StaticResource MutedText}"
                           Visibility="{Binding HasNoSelection, Converter={StaticResource Visible}}" />
                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
                  <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Remove" Command="{Binding RemoveFieldCommand}" Style="{StaticResource Small}"
                            Visibility="{Binding HasSelectedField, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding SelectionTitle}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="{Binding MainKindLabel}" Command="{Binding MainKindCommand}" Tag="{Binding SelectedIsMainKind}" Style="{StaticResource KindOn}" Margin="0,0,4,0" />
                    <Button Content="Read-only" Command="{Binding AddReadOnlyCommand}" Tag="{Binding SelectedIsReadOnly}" Style="{StaticResource KindOn}" HorizontalAlignment="Left"
                            ToolTip="Text that never changes, e.g. a bracket or the decimal point" />
                  </DockPanel>

                  <ContentControl Content="{Binding SelectedField}" Focusable="False" Visibility="{Binding HasSelectedField, Converter={StaticResource Visible}}">
                    <ContentControl.ContentTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <!-- Wheel -->
                          <WrapPanel Visibility="{Binding IsWheel, Converter={StaticResource Visible}}">
                            <StackPanel Margin="0,0,10,0">
                              <TextBlock Text="Control" Style="{StaticResource MutedText}" />
                              <local:SearchBox Items="{Binding DataContext.InputControls, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Text="{Binding Control, UpdateSourceTrigger=LostFocus}" Width="220"
                                               ToolTip="The wheel's DCS-BIOS control. Type words to search, e.g. &quot;uhf 1mhz&quot;" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                              <TextBlock Text="Range" Style="{StaticResource MutedText}" />
                              <TextBox Text="{Binding Range, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Width="110"
                                       ToolTip="What the wheel shows, in click order: 0-9, 22-39, or a list like X,Y" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                              <TextBlock Text="Mode" Style="{StaticResource MutedText}" />
                              <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Width="90"
                                        ToolTip="click: spring wheel (up/down clicks) · step: INC/DEC · set: send the position" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0" VerticalAlignment="Bottom">
                              <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6">
                                <Run Text="Place" /> <Run Text="{Binding Place, Mode=OneWay}" Foreground="{StaticResource Text}" />
                                <Run Text=" · Width" /> <Run Text="{Binding Width, Mode=OneWay}" Foreground="{StaticResource Text}" />
                              </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                              <Button Content="▲" Style="{StaticResource Small}" Command="{Binding ClickUpCommand}" Margin="0,0,4,0" ToolTip="Send one click up (DCS must be running)" />
                              <Button Content="▼" Style="{StaticResource Small}" Command="{Binding ClickDownCommand}" Margin="0,0,8,0" ToolTip="Send one click down (DCS must be running)" />
                              <TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                          </WrapPanel>
                          <!-- Keypad -->
                          <StackPanel Orientation="Horizontal" Visibility="{Binding IsKeypad, Converter={StaticResource Visible}}">
                            <TextBlock Text="Text sits" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ToggleButton Content="Left" IsChecked="{Binding AlignLeft}" Padding="10,3" Margin="0,0,4,0" />
                            <ToggleButton Content="Right" IsChecked="{Binding AlignRight}" Padding="10,3" Margin="0,0,14,0" />
                            <TextBlock Text="Never cleared automatically. Add a CLR press in the main window if needed." Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                          </StackPanel>
                          <!-- Read-only -->
                          <TextBlock Text="Read-only: never entered, skipped when the value is placed." Style="{StaticResource MutedText}"
                                     Visibility="{Binding IsReadOnly, Converter={StaticResource Visible}}" />
                        </StackPanel>
                      </DataTemplate>
                    </ContentControl.ContentTemplate>
                  </ContentControl>
                  <TextBlock Text="{Binding SelectedPreview}" FontFamily="Cascadia Mono, Consolas" FontSize="15" Foreground="{StaticResource Good}" Margin="0,8,0,0"
                             Visibility="{Binding SelectedPreview, Converter={StaticResource NotEmpty}}" />
                </StackPanel>
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding HasMessage, Converter={StaticResource Visible}}" />
              </StackPanel>
            </Border>

            <!-- Field table -->
            <Grid Margin="10,0,10,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="70" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Field" Style="{StaticResource MutedText}" />
              <TextBlock Grid.Column="1" Text="Type" Style="{StaticResource MutedText}" />
              <TextBlock Grid.Column="2" Text="Control" Style="{StaticResource MutedText}" />
              <TextBlock Grid.Column="3" Text="Range" Style="{StaticResource MutedText}" />
              <TextBlock Grid.Column="4" Text="Shows" Style="{StaticResource MutedText}" />
              <TextBlock Grid.Column="5" Text="Place" Style="{StaticResource MutedText}" />
              <TextBlock Grid.Column="6" Text="Width" Style="{StaticResource MutedText}" />
              <TextBlock Grid.Column="7" Text="Mode" Style="{StaticResource MutedText}" />
            </Grid>
            <TextBlock Text="No fields yet. Pick characters above, or use Fill from radio…" Style="{StaticResource MutedText}" Margin="10,4"
                       Visibility="{Binding Fields.Count, Converter={StaticResource NotEmpty}, ConverterParameter=invert}" />
            <ItemsControl ItemsSource="{Binding Fields}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="10,0,10,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="56" />
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="50" />
                      <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{Binding Name}" Command="{Binding SelectCommand}" Style="{StaticResource Small}" Margin="0,0,8,0" ToolTip="Select this field" />
                    <TextBlock Grid.Column="1" Text="{Binding KindLabel}" VerticalAlignment="Center" Foreground="{StaticResource Text}" />
                    <TextBlock Grid.Column="2" Text="{Binding Control}" Style="{StaticResource Mono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <TextBox Grid.Column="3" Text="{Binding Range, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Margin="0,0,8,0"
                             Visibility="{Binding IsWheel, Converter={StaticResource Visible}}" />
                    <TextBlock Grid.Column="4" Text="{Binding Shown}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="{Binding Place}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="{Binding Width}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="7" Text="{Binding Mode}" VerticalAlignment="Center" Foreground="{StaticResource Text}"
                               Visibility="{Binding IsWheel, Converter={StaticResource Visible}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Keypad keys -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding IsKeypad, Converter={StaticResource Visible}}">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Press" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding Press, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Width="50" Margin="0,0,10,0" ToolTip="Arguments of one key press, e.g. 1,0" />
                <Button Content="Fill from keypad…" Style="{StaticResource Small}" Command="{Binding FillKeysCommand}" Margin="0,0,6,0" />
                <Button Content="+ Key" Style="{StaticResource Small}" Command="{Binding AddKeyCommand}" />
              </StackPanel>
              <TextBlock Text="KEYPAD KEYS" Style="{StaticResource Heading}" VerticalAlignment="Center" Margin="0" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Keys}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource Field}" BorderThickness="2" CornerRadius="4" Padding="6,2" Margin="0,0,6,6" Width="168">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Used}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Good}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Missing}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Bad}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Style="{StaticResource Mono}" Foreground="{StaticResource Accent}" Width="40" VerticalAlignment="Center" />
                      <local:SearchBox Items="{Binding DataContext.InputControls, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Text="{Binding Control, UpdateSourceTrigger=LostFocus}" ToolTip="Key control; empty = skip this character. Type words to search." />
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                       Text="Green = used by the try value. Red = used but has no key: the command stops before pressing anything." />
          </StackPanel>
        </Border>

        <!-- Advanced (wheels) -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding IsWheels, Converter={StaticResource Visible}}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="AdvancedToggle" Content="Advanced…" Padding="10,3" />
              <TextBlock Text="Click arguments and timing for all wheels" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <WrapPanel Margin="0,8,0,0" Visibility="{Binding IsChecked, ElementName=AdvancedToggle, Converter={StaticResource Visible}}">
              <TextBlock Text="Click up" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox Text="{Binding Up, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Width="60" Margin="0,0,14,0" ToolTip="Arguments of one click up, e.g. 2,1" />
              <TextBlock Text="Click down" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox Text="{Binding Down, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Width="60" Margin="0,0,14,0" ToolTip="Arguments of one click down, e.g. 0,1" />
              <TextBlock Text="Delay ms" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Width="60" Margin="0,0,14,0" />
              <TextBlock Text="Max clicks" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox Text="{Binding MaxSteps, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Width="60" Margin="0,0,14,0" />
              <StackPanel Orientation="Horizontal" Visibility="{Binding ShowDecimals, Converter={StaticResource Visible}}">
                <TextBlock Text="Implied decimals" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding Decimals, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Width="40"
                         ToolTip="For a display without a decimal point: 1 when it shows 2513 for 251.3" />
              </StackPanel>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- Problems -->
        <ItemsControl ItemsSource="{Binding Problems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
