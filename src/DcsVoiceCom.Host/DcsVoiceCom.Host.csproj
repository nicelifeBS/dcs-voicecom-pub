<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0</SupportedOSPlatformVersion>
    <AssemblyName>dcsvoicecom-host</AssemblyName>
    <RootNamespace>DcsVoiceCom.Host</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DcsVoiceCom.Core\DcsVoiceCom.Core.csproj" />
    <ProjectReference Include="..\DcsVoiceCom.Windows\DcsVoiceCom.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\assets\cues\*.wav" Link="cues\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The bundled Whistle model and engine (Windows files), so the app needs no download. -->
    <None Include="..\..\model\cactus-needle\**" Exclude="..\..\model\cactus-needle\**\*.so"
          Link="model\cactus-needle\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
